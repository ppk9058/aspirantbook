// ─── PYQ (Previous Year Questions) Management Models ─────────────────────

model PyqCategory {
  id          String        @id @default(cuid())
  name        String        @unique // e.g. "BPSC", "UPSC", "UPPSC"
  slug        String        @unique // e.g. "bpsc", "uppsc"
  fullName    String?       // e.g. "Bihar Public Service Commission"
  description String?
  iconUrl     String?
  badgeColor  String?       @default("#f97316")
  order       Int           @default(0)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subExams    PyqSubExam[]
  papers      PyqPaper[]

  @@index([slug])
  @@index([isPublished])
}

model PyqSubExam {
  id          String       @id @default(cuid())
  categoryId  String
  name        String       // e.g. "CCE (Combined Competitive)", "CDPO", "AEDO"
  slug        String       // e.g. "cce", "cdpo", "aedo"
  description String?
  order       Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  category    PyqCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  papers      PyqPaper[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model PyqPaper {
  id             String         @id @default(cuid())
  categoryId     String
  subExamId      String?
  creatorId      String?        // User (Admin/Teacher) who uploaded
  
  title          String         // e.g. "69th BPSC PYQ Full Length Official Paper"
  slug           String         @unique
  year           Int            // e.g. 2024, 2023, 2022
  stage          String         @default("PRELIMS") // PRELIMS, MAINS, INTERVIEW, THEORY
  shift          String?        // e.g. "Shift 1", "Morning"
  examDate       DateTime?

  // Paper Metrics
  durationMin    Int            @default(120)
  totalMarks     Int            @default(150)
  totalQuestions Int            @default(150)
  languages      String[]       @default(["Hindi", "English"])

  // PDF Storage
  paperPdfUrl    String         // Main question paper PDF
  solutionPdfUrl String?        // Answer key + solutions PDF
  pdfFileSizeKb  Int?
  pageCount      Int?

  // Monetization & Access Control
  accessType     String         @default("FREE") // FREE, PAID, PASS_ONLY
  unlockPrice    Int            @default(0)      // In INR, e.g. 49
  isPassIncluded Boolean        @default(true)   // Included in TrillionPass

  // CBT Integration Link
  cbtTestId      String?        // Foreign key to ExamTest model
  hasCbtMode     Boolean        @default(false)

  // Status & Metrics
  status         String         @default("PUBLISHED") // DRAFT, IN_REVIEW, PUBLISHED, ARCHIVED
  subject        String?
  // Authwall Gate Settings & Pre-chunking
  isGated           Boolean        @default(false)
  previewPercentage Int            @default(20)
  seoMode           String         @default("preview") // "preview" | "bot-full"
  gateTitle         String?
  gateSubtitle      String?
  blockCount        Int?
  contentHash       String?
  downloadCount  Int            @default(0)
  attemptCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  category       PyqCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subExam        PyqSubExam?    @relation(fields: [subExamId], references: [id], onDelete: SetNull)
  leads          PyqLeadCapture[]
  unlocks        PyqUnlock[]

  @@index([categoryId, year])
  @@index([subExamId])
  @@index([accessType])
  @@index([subject])
}

model PyqLeadCapture {
  id          String    @id @default(cuid())
  paperId     String
  phoneNumber String
  userId      String?
  source      String    @default("PDF_DOWNLOAD")
  createdAt   DateTime  @default(now())

  paper       PyqPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  @@index([phoneNumber])
  @@index([paperId])
}

model PyqUnlock {
  id          String        @id @default(cuid())
  userId      String
  paperId     String
  paymentId   String?
  amountPaid  Int           @default(0)
  unlockedAt  DateTime      @default(now())

  paper       PyqPaper      @relation(fields: [paperId], references: [id], onDelete: Cascade)
  @@unique([userId, paperId])
  @@index([userId])
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  @@index([windowStart])
}

model CurrentAffairsPdf {
  id            String    @id @default(cuid())
  title         String
  titleHi       String?
  month         Int       // 1-12
  year          Int       // e.g. 2026
  pdfUrlEn      String?
  pdfUrlHi      String?
  fileSizeKbEn  Int?
  fileSizeKbHi  Int?
  status        String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  // Authwall Gate Settings & Pre-chunking
  isGated       Boolean   @default(false)
  previewPercentage Int   @default(20)
  seoMode       String    @default("preview") // "preview" | "bot-full"
  gateTitle     String?
  gateSubtitle  String?
  blockCount    Int?
  contentHash   String?
  downloadCount Int       @default(0)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy     User?     @relation("UserCurrentAffairsPdfs", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([year, month])
  @@index([status])
  @@index([createdById])
  @@index([status, year, month])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
}

/// Callback requests from the course page. Stored in our own DB only — no SMS is sent.
enum CallbackLeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model CourseUnit {
  id               String                  @id @default(cuid())
  courseId         String
  title            String
  titleHi          String?
  tags             String[]                @default([])
  order            Float                   @default(1000)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  course           Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters         Chapter[]
  syllabusSections CourseSyllabusSection[]

  @@index([courseId])
  @@index([order])
}

model CourseCallbackLead {
  id          String             @id @default(cuid())
  courseId    String
  name        String
  mobile      String // E.164, e.g. +919876543210
  status      CallbackLeadStatus @default(NEW)
  note        String?
  source      String             @default("COURSE_DETAIL")
  utm         String?
  handledById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  handledBy   User?              @relation("UserHandledCallbackLeads", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([createdAt])
  @@index([courseId, mobile, createdAt])
}

/// Exam syllabus authored per course. Optional: courses without papers hide the section.
model CourseSyllabusPaper {
  id              String                  @id @default(cuid())
  courseId        String
  key             String // e.g. "PRELIMS-GS"
  title           String
  titleHi         String?
  marks           Int?
  durationMinutes Int?
  introText       String?
  introTextHi     String?
  order           Float                   @default(1000)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  course          Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections        CourseSyllabusSection[]

  @@unique([courseId, key])
  @@index([courseId])
}

/// One syllabus section. Links to the real PYQ taxonomy via pyqSubject/pyqTopic,
/// which map to ContentEngineQuestion.sub / .top (both indexed).
model CourseSyllabusSection {
  id          String              @id @default(cuid())
  paperId     String
  title       String
  titleHi     String?
  subtopics   String[]            @default([])
  subtopicsHi String[]            @default([])
  order       Float               @default(1000)
  unitId      String?
  chapterId   String?
  pyqSubject  String?
  pyqTopic    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  paper       CourseSyllabusPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  unit        CourseUnit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  chapter     Chapter?            @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([paperId])
  @@index([unitId])
  @@index([chapterId])
  @@index([pyqSubject, pyqTopic])
}

model ContentEngineBatch {
  id             String                  @id @default(cuid())
  createdById    String?
  pastedText     String                  @db.Text
  defaultSubject String?
  defaultTopic   String?
  defaultExam    String?
  defaultYear    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  questions      ContentEngineQuestion[]

  @@index([createdById])
  @@index([createdAt])
}

model ContentEngineQuestion {
  id           String                         @id @default(cuid())
  shortId      String                         @unique
  textHash     String                         @unique
  q            String                         @db.Text
  options      Json
  answer       String
  answerIndex  Int                            @default(-1)
  explanation  String?                        @db.Text
  sub          String?
  top          String?
  exam         String?
  year         String?
  sourceTag    String?
  sourceNo     Int?
  batchId      String?
  status       String                         @default("DRAFT") // DRAFT, IN_REVIEW, PUBLISHED, ARCHIVED
  isPublished  Boolean                        @default(false)
  isInferred   Boolean                        @default(false)
  isVerified   Boolean                        @default(false)
  slug         String?
  publishedAt  DateTime?
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  batch        ContentEngineBatch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  translations ContentEngineTranslation[]
  override     ContentEngineCategoryOverride?

  @@index([batchId])
  @@index([isPublished])
  @@index([sub, top])
  @@index([exam, year])
  @@index([createdAt])
}

model ContentEngineTranslation {
  id           String                @id @default(cuid())
  questionId   String
  lang         String // "hi" | "en"
  q            String                @db.Text
  options      Json
  answer       String?
  explanation  String?               @db.Text
  top          String?
  isReviewed   Boolean               @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  question     ContentEngineQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, lang])
  @@index([questionId])
  @@index([lang, isReviewed])
}

model ContentEngineCategoryOverride {
  id         String                @id @default(cuid())
  questionId String                @unique
  sub        String
  top        String
  subHi      String?
  topHi      String?
  exam       String?
  year       String?
  isManual   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  question   ContentEngineQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ContentEngineExamAlias {
  id        String   @id @default(cuid())
  name      String   @unique
  pattern   String?
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
}

model ContentEngineSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id            String          @id @default(cuid())
  name          String
  nameHi        String?
  role          String?
  roleHi        String?
  bio           String?
  bioHi         String?
  avatar        String?
  credentials   Json?           @default("[]")
  credentialsHi Json?           @default("[]")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  courses       CourseTeacher[]

  @@index([name])
}

model CourseTeacher {
  id        String   @id @default(cuid())
  courseId  String
  teacherId String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  role      String?
  roleHi    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([courseId])
  @@index([teacherId])
  @@index([order])
}



