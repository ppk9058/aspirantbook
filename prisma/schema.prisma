generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String?
  name               String?
  image              String?
  phoneNumber        String?             @unique
  role               UserRole            @default(FREE)
  xp                 Int                 @default(0)
  level              Int                 @default(1)
  streak             Int                 @default(0)
  lastActive         DateTime?
  selectedGoal       String?
  selectedSubGoal    String?
  emailVerified      DateTime?
  isActive           Boolean             @default(true)
  sessionVersion     Int                 @default(1)
  failedLoginAttempts Int                @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  assessmentAttempts AssessmentAttempt[]
  contentUploads     ContentUpload[]
  enrollments        Enrollment[]
  notifications      Notification[]
  payments           Payment[]
  progress           Progress[]
  submissions        Submission[]
  subscriptions      Subscription[]
  achievements       UserAchievement[]
  userAnalytics      UserAnalytics[]
  examAttempts       ExamAttempt[]
  examSeriesEnrollments ExamSeriesEnrollment[]
  demoBookings       CourseDemoBooking[]
  demoBookingsV2     DemoBooking[]
  demoStageSessions  DemoStageSession[]
  couponRedemptions  CouponRedemption[]
  createdDemoSlots   DemoSlot[]          @relation("UserCreatedDemoSlots")
  currentAffairsPdfs CurrentAffairsPdf[] @relation("UserCurrentAffairsPdfs")
  handledCallbackLeads CourseCallbackLead[] @relation("UserHandledCallbackLeads")

  @@index([email])
  @@index([role])
  @@index([phoneNumber])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Track {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  type        TrackType
  description String
  thumbnail   String?
  order       Int           @default(0)
  isPublished Boolean       @default(false)
  createdAt   DateTime      @default(now())
  courses     TrackCourse[]

  @@index([type])
  @@index([slug])
}

model Course {
  id              String            @id @default(cuid())
  title           String
  titleHi         String?
  subtitle        String?
  subtitleHi      String?
  slug            String            @unique
  description     String
  descriptionHi   String?
  thumbnailUrl    String?
  difficulty      Difficulty
  duration        Int               @default(0)
  rating          Float             @default(0)
  enrollmentCount Int               @default(0)
  technology      String            @default("")
  prerequisites   String[]
  status          CourseStatus      @default(DRAFT)
  isPremium       Boolean           @default(false)
  isPublished     Boolean           @default(false)
  price           Int?              @default(0)
  originalPrice   Int?              @default(0)
  discountPercent Int?              @default(0)
  couponCode      String?           @default("OFF50")
  couponDiscount  Int?              @default(50)
  expiresAt       String?           @default("Oct 30, 2026")
  hasTrialLesson  Boolean           @default(true)
  metadataJson    String?
  externalId      String?           @unique
  theme           Json?
  schemaVersion   Int               @default(1)
  // Authwall Gate Settings
  isGated           Boolean           @default(false)
  previewPercentage Int               @default(20)
  seoMode           String            @default("preview") // "preview" | "bot-full"
  gateTitle         String?
  gateSubtitle      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  chapters        Chapter[]
  contentUploads  ContentUpload[]
  courseAnalytics CourseAnalytics[]
  enrollments     Enrollment[]
  reviews         Review[]
  tracks          TrackCourse[]
  demoBookings    CourseDemoBooking[]
  demoSlots       DemoSlot[]
  demoBookingsV2  DemoBooking[]
  coupons         Coupon[]
  couponRedemptions CouponRedemption[]
  units           CourseUnit[]
  callbackLeads   CourseCallbackLead[]
  syllabusPapers  CourseSyllabusPaper[]
  teachers        CourseTeacher[]

  @@index([slug])
  @@index([difficulty])
  @@index([status])
  @@index([isPublished])
  @@index([status, enrollmentCount])
}

model TrackCourse {
  id         String  @id @default(cuid())
  trackId    String
  courseId   String
  order      Int
  isRequired Boolean @default(true)
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  track      Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, courseId])
  @@index([trackId])
  @@index([courseId])
}

model Chapter {
  id             String          @id @default(cuid())
  externalId     String?
  title          String
  titleHi        String?
  description    String?
  descriptionHi  String?
  subtopics      String[]        @default([])
  subtopicsHi    String[]        @default([])
  order          Float           @default(1000)
  archivedAt     DateTime?
  locked         Boolean         @default(false)
  // Authwall Gate Settings
  gateMode       String          @default("inherit") // "inherit" | "free" | "preview" | "locked"
  previewPercentage Int?
  courseId       String
  unitId         String?
  createdAt      DateTime        @default(now())
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  unit           CourseUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  contentUploads ContentUpload[]
  lessons        Lesson[]
  syllabusSections CourseSyllabusSection[]

  @@unique([courseId, externalId])
  @@index([courseId])
  @@index([order])
  @@index([unitId])
}

model Lesson {
  id                        String          @id @default(cuid())
  externalId                String?
  title                     String
  titleHi                   String?
  type                      LessonType
  order                     Float           @default(1000)
  xpReward                  Int             @default(10)
  videoUrl                  String?
  content                   String?
  contentHi                 String?
  slides                    String?
  duration                  Int?
  durationText              String?
  isTrial                   Boolean         @default(false)
  scheduledAt               DateTime?
  attachmentType            String?
  attachmentUrl             String?
  attachmentName            String?
  chapterId                 String
  archivedAt                DateTime?
  locked                    Boolean         @default(false)
  // Authwall Gate Settings & Pre-chunking
  gateMode                  String          @default("inherit") // "inherit" | "free" | "preview" | "locked"
  previewPercentage         Int?
  blockCount                Int?
  contentHash               String?
  schemaVersion             Int             @default(1)
  currentPublishedVersionId String?
  currentDraftVersionId     String?
  createdAt                 DateTime        @default(now())
  exercises                 Exercise[]
  chapter                   Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress                  Progress[]
  versions                  LessonVersion[] @relation("LessonAllVersions")
  currentPublishedVersion   LessonVersion?  @relation("LessonCurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  currentDraftVersion       LessonVersion?  @relation("LessonCurrentDraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)

  @@unique([chapterId, externalId])
  @@index([chapterId])
  @@index([scheduledAt])
  @@index([type])
  @@index([order])
  @@index([currentPublishedVersionId])
  @@index([currentDraftVersionId])
}

model LessonVersion {
  id                      String   @id @default(cuid())
  lessonId                String
  status                  String   // "draft" | "published"
  blocks                  Json
  schemaVersion           Int      @default(1)
  contentHash             String?
  needsReview             Boolean  @default(false)
  createdBy               String?
  createdAt               DateTime @default(now())
  note                    String?
  source                  String   @default("import") // "import" | "editor" | "restore"
  lesson                  Lesson   @relation("LessonAllVersions", fields: [lessonId], references: [id], onDelete: Cascade)
  publishedForLessons     Lesson[] @relation("LessonCurrentPublishedVersion")
  draftForLessons         Lesson[] @relation("LessonCurrentDraftVersion")

  @@index([lessonId])
  @@index([lessonId, createdAt])
  @@index([status])
  @@index([contentHash])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([userId, enrolledAt(sort: Desc)])
}

// Tracks student bookings for live demo classes
model CourseDemoBooking {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  phoneNumber String
  slotDate    String    // e.g. "Today" or "Tomorrow"
  slotTime    String    // e.g. "6:00 PM"
  status      String    @default("SCHEDULED") // SCHEDULED | LIVE | ATTENDED | COMPLETED
  joinedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

enum DemoSlotStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum DemoBookingStatus {
  BOOKED
  JOINED
  ATTENDED
  MISSED
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  FAILED
  PENDING_TEMPLATE
}

model DemoSlot {
  id               String            @id @default(cuid())
  createdById      String?
  courseId         String
  startTime        DateTime          // UTC datetime
  durationMinutes  Int               @default(60)
  topic            String
  facultyName      String
  agoraChannelName String            @unique // ONE channel per slot, shared by all students
  maxAudience      Int               @default(100)
  status           DemoSlotStatus    @default(SCHEDULED)
  stageLayout      String            @default("CORNER") // CORNER | SPLIT
  maxOnStage       Int               @default(1)
  startedAt        DateTime?
  endedAt          DateTime?
  hostHeartbeatAt  DateTime?
  teacherLayout       String            @default("FACE_ONLY") // FACE_ONLY | SCREEN_WITH_FACE_CORNER | SCREEN_ONLY
  screenShareActive   Boolean           @default(false)
  facePosition        String            @default("top-right") // top-right | top-left | bottom-left | bottom-right
  screenStartedAt     DateTime?
  screenEndedAt       DateTime?
  totalScreenMinutes  Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation("UserCreatedDemoSlots", fields: [createdById], references: [id], onDelete: SetNull)
  bookings         DemoBooking[]
  chatMessages     DemoChatMessage[]
  stageSessions    DemoStageSession[]

  @@index([courseId])
  @@index([createdById])
  @@index([startTime])
  @@index([status])
}

model DemoBooking {
  id            String             @id @default(cuid())
  studentId     String
  mobile        String             // E.164 normalized e.g. +91XXXXXXXXXX
  slotId        String
  courseId      String
  status        DemoBookingStatus  @default(BOOKED)
  joinedAt      DateTime?
  leftAt        DateTime?
  lastSeenAt    DateTime?
  handRaisedAt  DateTime?
  watchSeconds  Int                @default(0)
  utmSource     String?
  utmCampaign   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  student       User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slot          DemoSlot           @relation(fields: [slotId], references: [id], onDelete: Cascade)
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messageLogs   WhatsAppMessageLog[]
  stageSessions DemoStageSession[]

  @@unique([studentId, slotId])
  @@index([studentId])
  @@index([slotId])
  @@index([courseId])
  @@index([status])
  @@index([lastSeenAt])
}

enum DemoStageMode {
  AUDIO_ONLY
  VIDEO_AUDIO
}

enum DemoStageStatus {
  INVITED
  ACCEPTED
  ON_STAGE
  REMOVED
  DECLINED
  EXPIRED
}

model DemoStageSession {
  id         String          @id @default(cuid())
  slotId     String
  userId     String
  bookingId  String
  mode       DemoStageMode   @default(VIDEO_AUDIO)
  status     DemoStageStatus @default(INVITED)
  invitedAt  DateTime        @default(now())
  startedAt  DateTime?
  endedAt    DateTime?
  micMuted   Boolean         @default(false)
  videoOff   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  slot       DemoSlot        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking    DemoBooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([slotId, status])
  @@index([userId])
  @@index([bookingId])
}

model WhatsAppMessageLog {
  id                String                @id @default(cuid())
  bookingId         String?
  recipientPhone    String
  templateName      String
  variablesJson     String
  status            WhatsAppMessageStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  scheduledFor      DateTime?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  booking           DemoBooking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
  @@index([scheduledFor])
}

// ---------------------------------------------------------------------------
// Live Demo Chat (real-time via 2-second DB polling with since-cursor)
// ---------------------------------------------------------------------------
model DemoChatMessage {
  id          String   @id @default(cuid())
  slotId      String
  userId      String
  displayName String   // first name + last 2 digits of phone if name missing
  role        String   // "STUDENT" | "TEACHER" | "ADMIN"
  message     String   @db.VarChar(300)
  isQuestion  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())

  slot        DemoSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId, createdAt])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Exercise {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  instructions String
  starterCode  String?
  solution     String?
  hints        String[]
  language     String
  difficulty   Difficulty   @default(BEGINNER)
  lessonId     String?
  isPractice   Boolean      @default(false)
  category     String?
  tags         String[]
  createdAt    DateTime     @default(now())
  lesson       Lesson?      @relation(fields: [lessonId], references: [id])
  submissions  Submission[]
  testCases    TestCase[]

  @@index([lessonId])
  @@index([isPractice])
  @@index([difficulty])
}

model TestCase {
  id             String   @id @default(cuid())
  exerciseId     String
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  createdAt      DateTime @default(now())
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

model Submission {
  id            String   @id @default(cuid())
  userId        String
  exerciseId    String
  code          String
  passed        Boolean
  output        String?
  executionTime Int?
  createdAt     DateTime @default(now())
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
  @@index([createdAt])
}

model Assessment {
  id           String              @id @default(cuid())
  title        String
  slug         String              @unique
  description  String?
  duration     Int
  passingScore Int                 @default(70)
  technology   String
  difficulty   Difficulty          @default(BEGINNER)
  isPublished  Boolean             @default(false)
  createdAt    DateTime            @default(now())
  attempts     AssessmentAttempt[]
  questions    Question[]

  @@index([slug])
  @@index([technology])
}

model Question {
  id            String       @id @default(cuid())
  type          QuestionType
  question      String
  options       Json?
  correctAnswer String
  explanation   String?
  points        Int          @default(1)
  order         Int          @default(0)
  assessmentId  String
  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([type])
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  userId       String
  assessmentId String
  answers      Json
  score        Int
  passed       Boolean
  timeSpent    Int
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assessmentId])
  @@index([completedAt])
}

model Progress {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean  @default(false)
  timeSpent    Int      @default(0)
  lastAccessed DateTime @default(now())
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([userId, lastAccessed])
  @@index([userId, completed])
}

model Achievement {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String
  icon        String
  xpReward    Int
  condition   Json
  createdAt   DateTime          @default(now())
  users       UserAchievement[]

  @@index([slug])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([unlockedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  plan              SubscriptionPlan
  status            SubscriptionStatus
  provider          PaymentProvider
  providerId        String
  startDate         DateTime
  endDate           DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payments          Payment[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, status, endDate])
}

model Payment {
  id               String            @id @default(cuid())
  userId           String
  subscriptionId   String?
  amount           Float
  currency         String            @default("USD")
  status           PaymentStatus
  paymentMethod    String?
  paymentProvider  String?
  externalId       String?           @unique
  razorpayOrderId  String?           @unique
  razorpayPaymentId String?          @unique
  metadata         Json?
  couponId         String?
  couponCode       String?
  originalAmount   Float?
  discountAmount   Float?
  createdAt        DateTime          @default(now())
  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon           Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption?

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([couponId])
  @@index([userId, status, createdAt])
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  courseId          String?
  discountType      String             // "PERCENT" | "FLAT"
  discountValue     Float
  maxDiscountAmount Float?
  maxRedemptions    Int?
  perUserLimit      Int                @default(1)
  validFrom         DateTime?
  validUntil        DateTime?
  isActive          Boolean            @default(true)
  offerAfterDemo    Boolean            @default(false)
  showOnThumbnail   Boolean            @default(false)
  badgeLabel        String?
  badgeShape        String?            // STARBURST | RIBBON | CIRCLE | PILL
  badgeColor        String?            // hex
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  course            Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  redemptions       CouponRedemption[]
  payments          Payment[]

  @@index([code])
  @@index([courseId])
  @@index([isActive])
}

model CouponRedemption {
  id        String    @id @default(cuid())
  couponId  String
  userId    String
  courseId  String?
  paymentId String    @unique
  status    String    @default("RESERVED") // "RESERVED" | "REDEEMED" | "RELEASED"
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  maxUses       Int?
  usedCount     Int          @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@index([code])
  @@index([isActive])
}

model ContentUpload {
  id                    String    @id @default(cuid())
  uploadedBy            String
  contentType           String
  fileName              String
  fileSize              BigInt?
  mimeType              String?
  fileUrl               String
  s3Key                 String?
  cdnUrl                String?
  status                String    @default("UPLOADING")
  processingProgress    Int       @default(0)
  errorMessage          String?
  metadata              Json?
  associatedCourseId    String?
  associatedChapterId   String?
  uploadStartedAt       DateTime  @default(now())
  uploadCompletedAt     DateTime?
  processingCompletedAt DateTime?
  associatedChapter     Chapter?  @relation(fields: [associatedChapterId], references: [id])
  associatedCourse      Course?   @relation(fields: [associatedCourseId], references: [id])
  uploader              User      @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy])
  @@index([associatedCourseId])
  @@index([status])
  @@index([contentType])
}

model CourseAnalytics {
  id                     String   @id @default(cuid())
  courseId               String
  date                   DateTime @db.Date
  totalEnrollments       Int      @default(0)
  newEnrollments         Int      @default(0)
  activeLearnersToday    Int      @default(0)
  completions            Int      @default(0)
  completionRate         Float    @default(0)
  avgCompletionTimeHours Float    @default(0)
  totalTimeSpentHours    Float    @default(0)
  avgTimePerUserHours    Float    @default(0)
  lessonsCompleted       Int      @default(0)
  exercisesCompleted     Int      @default(0)
  averageRating          Float    @default(0)
  newReviews             Int      @default(0)
  revenueGenerated       Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  course                 Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, date])
  @@index([courseId])
  @@index([date])
}

model UserAnalytics {
  id                   String   @id @default(cuid())
  userId               String
  date                 DateTime @db.Date
  loginCount           Int      @default(0)
  timeSpentMinutes     Int      @default(0)
  lessonsCompleted     Int      @default(0)
  exercisesCompleted   Int      @default(0)
  assessmentsTaken     Int      @default(0)
  xpEarned             Int      @default(0)
  achievementsUnlocked Int      @default(0)
  streakDays           Int      @default(0)
  coursesEnrolled      Int      @default(0)
  coursesCompleted     Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model RevenueAnalytics {
  id                      String   @id @default(cuid())
  date                    DateTime @unique @db.Date
  totalRevenue            Float    @default(0)
  newSubscriptionsRevenue Float    @default(0)
  renewalRevenue          Float    @default(0)
  refunds                 Float    @default(0)
  netRevenue              Float    @default(0)
  newSubscriptions        Int      @default(0)
  cancelledSubscriptions  Int      @default(0)
  activeSubscriptions     Int      @default(0)
  mrr                     Float    @default(0)
  arr                     Float    @default(0)
  churnRate               Float    @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([date])
}

// ─── Test Series Engine ───────────────────────────────────────────────────

model ExamSeries {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  examName     String       // e.g. "BPSC Exam"
  category     String       // e.g. "Civil Services"
  description  String?
  thumbnailUrl String?
  logoType     String?
  highlights   String[]     @default([])
  isFree       Boolean      @default(false)
  isPublished  Boolean      @default(false)
  isPro        Boolean      @default(false)
  totalTests   Int          @default(0)
  freeTests    Int          @default(0)
  usersCount   Int          @default(0)
  languages    String       @default("English, Hindi")
  // Authwall Gate Settings
  isGated      Boolean      @default(false)
  previewPercentage Int      @default(20)
  seoMode      String       @default("preview") // "preview" | "bot-full"
  gateTitle    String?
  gateSubtitle String?
  bannerUrl    String?
  syllabus     String?
  keyFeatures  String[]     @default([])
  whyThisSeries String?
  isArchived   Boolean      @default(false)
  archivedAt   DateTime?
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tests        ExamTest[]
  enrollments  ExamSeriesEnrollment[]
  slugHistory  PackageSlugHistory[]

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@index([isPublished, createdAt])
  @@index([isArchived])
}

model PackageSlugHistory {
  id        String     @id @default(cuid())
  seriesId  String
  oldSlug   String     @unique
  newSlug   String
  createdAt DateTime   @default(now())
  series    ExamSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([oldSlug])
  @@index([seriesId])
}

// Tracks a student's enrollment / pass purchase for a test series
model ExamSeriesEnrollment {
  id           String                      @id @default(cuid())
  userId       String
  seriesId     String
  enrollType   ExamSeriesEnrollType        @default(FREE)
  status       ExamSeriesEnrollStatus      @default(ACTIVE)
  enrolledAt   DateTime                    @default(now())
  expiresAt    DateTime?
  orderId      String?                     // payment order reference
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  series       ExamSeries                  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([userId])
  @@index([seriesId])
  @@index([status])
  @@index([userId, status, expiresAt])
}

enum ExamSeriesEnrollType {
  FREE      // enrolled free series
  PASS      // bought pass
  PURCHASED // bought individual series
}

enum ExamSeriesEnrollStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model ExamTest {
  id              String        @id @default(cuid())
  seriesId        String
  title           String
  titleHi         String?       // Hindi title
  testType        ExamTestType  @default(FULL_MOCK)
  accessMode      ExamAccess    @default(PRO)
  durationMinutes Int           @default(120)
  totalQuestions  Int           @default(150)
  totalMarks      Int           @default(150)
  positiveMarks   Float         @default(1.0)
  negativeMarks   Float         @default(0.33)
  instructions    String?
  syllabus        String?
  syllabusHi      String?       // Hindi syllabus
  isLive          Boolean       @default(false)
  liveStartAt     DateTime?
  liveEndAt       DateTime?
  order           Int           @default(0)
  month           Int?
  year            Int?
  isPublished     Boolean       @default(false)
  isArchived      Boolean       @default(false)
  archivedAt      DateTime?
  // Authwall Gate Settings & Pre-chunking
  gateMode          String        @default("inherit") // "inherit" | "free" | "preview" | "locked"
  previewPercentage Int?
  blockCount        Int?
  contentHash       String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  series          ExamSeries    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  sections        ExamSection[]
  attempts        ExamAttempt[]

  @@index([seriesId])
  @@index([testType])
  @@index([isPublished])
  @@index([seriesId, isPublished])
  @@index([year, month])
  @@index([isArchived])
}

model ExamSection {
  id            String        @id @default(cuid())
  testId        String
  title         String
  titleHi       String?
  order         Int           @default(0)
  positiveMarks Float         @default(1.0)
  negativeMarks Float         @default(0.33)
  timeLimitMins Int?          // null = shared global timer
  test          ExamTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions     ExamQuestion[]

  @@index([testId])
  @@index([testId, order])
}

model ExamQuestion {
  id             String             @id @default(cuid())
  sectionId      String
  questionType   ExamQuestionType   @default(MCQ)
  questionEn     String             // English text
  questionHi     String?            // Hindi text
  optionAEn      String?
  optionBEn      String?
  optionCEn      String?
  optionDEn      String?
  optionAHi      String?
  optionBHi      String?
  optionCHi      String?
  optionDHi      String?
  correctOption  String             // "A", "B", "C", "D" or JSON for MSQ
  explanationEn  String?
  explanationHi  String?
  videoUrl       String?
  difficulty     ExamDifficulty     @default(MODERATE)
  subject        String?
  topic          String?
  subTopic       String?
  order          Int                @default(0)
  positiveMarks  Float              @default(1.0)
  negativeMarks  Float              @default(0.33)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  section        ExamSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers        ExamAttemptAnswer[]

  @@index([sectionId])
  @@index([sectionId, order])
  @@index([difficulty])
  @@index([subject])
}

model ExamAttempt {
  id              String             @id @default(cuid())
  userId          String
  testId          String
  language        String             @default("English")
  status          ExamAttemptStatus  @default(IN_PROGRESS)
  score           Float              @default(0)
  totalMarks      Int                @default(0)
  correctCount    Int                @default(0)
  wrongCount      Int                @default(0)
  skippedCount    Int                @default(0)
  markedCount     Int                @default(0)
  timeTakenSecs   Int                @default(0)
  percentile      Float?
  allIndiaRank    Int?
  tabSwitchCount  Int                @default(0)
  startedAt       DateTime           @default(now())
  submittedAt     DateTime?
  answers         ExamAttemptAnswer[]
  test            ExamTest           @relation(fields: [testId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
  @@index([status])
  @@index([startedAt])
  @@index([submittedAt])
  @@index([userId, status])
  @@index([testId, status])
  @@index([userId, testId])
  @@index([testId, status, score])
}

model ExamAttemptAnswer {
  id              String       @id @default(cuid())
  attemptId       String
  questionId      String
  selectedOption  String?      // "A","B","C","D" or null
  isMarked        Boolean      @default(false)
  isCorrect       Boolean?
  marksAwarded    Float        @default(0)
  timeSpentSecs   Int          @default(0)
  clientSeq       Int          @default(0)
  attempt         ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

