{
  "name": "aspirantbook",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run db:check",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:mobile-api": "ALLOW_DEV_MOBILE_LOGIN=true NODE_OPTIONS='--max-old-space-size=4096' next dev -H 0.0.0.0 -p 3045",
    "db:check": "tsx scripts/db-check.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:launch-placeholders": "node scripts/check-launch-placeholders.mjs",
    "postinstall": "prisma generate",
    "seed:test": "tsx scripts/seed-docker-test-db.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:reset": "docker compose -f docker-compose.test.yml down -v && docker compose -f docker-compose.test.yml up -d",
    "test:e2e:test-series": "bash scripts/test-series-e2e.sh",
    "test:e2e:studio": "BASE_URL=http://127.0.0.1:3045 npx playwright test tests/e2e/teacher-authoring-to-student.spec.ts",
    "test:e2e:canary": "APP_ENV=test BASE_URL=http://127.0.0.1:3045 npx playwright test --project=canary",
    "test:e2e:real-catalogue": "npx tsx scripts/reset-test-catalogue.ts && CATALOGUE_CASE=empty BASE_URL=http://127.0.0.1:3045 npx playwright test --project=real-catalogue-desktop --project=real-catalogue-mobile",
    "test:e2e:dev-smoke": "DEV_SMOKE=1 BASE_URL=http://127.0.0.1:3045 npx playwright test tests/e2e/dev-smoke.spec.ts",
    "content:chunk": "tsx scripts/content-chunk.ts",
    "perf:check": "tsx scripts/perf-check.ts",
    "test:content-engine": "tsx --test --test-concurrency=1 tests/content-engine/**/*.test.ts",
    "test:proof:http": "tsx scripts/run-proof-suite.ts --mode=http",
    "test:proof:all": "tsx scripts/run-proof-suite.ts --mode=all",
    "dev:lan": "node scripts/dev-lan.mjs",
    "mobile:env": "node scripts/mobile-env.mjs",
    "seed:mobile-test": "node --env-file=.env.test node_modules/.bin/tsx scripts/seed-mobile-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.21.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.2.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.4",
    "@sentry/nextjs": "11.8.0",
    "@stripe/stripe-js": "^8.5.3",
    "@tanstack/react-query": "^5.62.11",
    "@trpc/client": "^11.0.0-rc.690",
    "@trpc/next": "^11.0.0-rc.690",
    "@trpc/react-query": "^11.0.0-rc.690",
    "@trpc/server": "^11.0.0-rc.690",
    "@types/dockerode": "^3.3.47",
    "@types/ioredis": "^4.28.10",
    "@types/katex": "^0.16.8",
    "agora-rtc-sdk-ng": "^4.24.8",
    "agora-token": "^2.0.6",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dockerode": "^4.0.9",
    "dompurify": "^3.4.17",
    "framer-motion": "^12.23.24",
    "ioredis": "^5.8.2",
    "katex": "^0.18.9",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "^4.9.155",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.66.1",
    "react-pdf": "^9.2.1",
    "react-player": "^2.16.1",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.0",
    "sonner": "^2.0.7",
    "stripe": "^17.7.0",
    "superjson": "^2.2.2",
    "swiper": "^12.1.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "fast-xml-parser": "5.11.2",
    "protobufjs": "7.6.6",
    "monaco-editor": {
      "dompurify": "3.4.17"
    },
    "brace-expansion@1": "1.1.21"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright-core": "^1.63.0",
    "prisma": "^6.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
