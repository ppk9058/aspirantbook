# ==============================================================================
# AspirantBook Platform Environment Variables Reference (.env.example)
#
# INSTRUCTIONS:
# - Copy this file to .env.local for local development.
# - DO NOT commit real secrets or production credentials to source control.
# - Each variable is categorized by service and annotated [REQUIRED] or [OPTIONAL].
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE PLATFORM & ENVIRONMENT
# ------------------------------------------------------------------------------
# [OPTIONAL] Node environment: 'development', 'production', or 'test'
NODE_ENV="development"

# [OPTIONAL] Application environment tier: 'development', 'staging', 'production', or 'test'
APP_ENV="development"

# [OPTIONAL] Local HTTP port (default: 3000)
PORT="3000"

# [REQUIRED in production] Public web application canonical URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [OPTIONAL] Canonical platform domain
CANONICAL_DOMAIN="aspirantbook.com"
NEXT_PUBLIC_CANONICAL_DOMAIN="aspirantbook.com"

# [OPTIONAL] Legacy website and site metadata URLs
WEBSITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AspirantBook"

# [OPTIONAL] Vercel deployment preview / commit tracking
VERCEL_URL=""
VERCEL_GIT_COMMIT_SHA=""
GIT_COMMIT=""
NEXT_PUBLIC_GIT_COMMIT=""

# [OPTIONAL] Emergency maintenance mode flag ("true" | "false")
MAINTENANCE_MODE="false"

# [OPTIONAL] Reverse proxy trust setting for secure client IP extraction ("true" | "false")
TRUST_PROXY="true"

# [OPTIONAL] Number of upstream proxy hops when reading X-Forwarded-For
TRUST_PROXY_HOPS="1"

# [OPTIONAL] Bearer token for detailed internal health check (/api/health?details=true)
HEALTH_DETAILS_TOKEN="replace-with-internal-health-auth-token"

# [OPTIONAL] Secret for authorized invocation of internal cron endpoints
CRON_SECRET="replace-with-cron-secret-token"

# [REQUIRED] Storage backend for forms, doubts, and audit logs ("db" or "fs").
# Production MUST be "db": local disk is ephemeral/read-only and the boot guard
# refuses to start with "fs" when NODE_ENV=production. Development/test default: "fs".
PERSIST_BACKEND="db"


# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Supabase / Prisma)
# ------------------------------------------------------------------------------
# [REQUIRED] Primary pooled database connection string (port 6543 for Supabase PgBouncer)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/trillionskill_dev?pgbouncer=true&connection_limit=5&pool_timeout=10"

# [REQUIRED] Direct database connection string for migrations and schema DDL (port 5432)
DIRECT_URL="postgresql://postgres:postgres_password@localhost:5432/trillionskill_dev"

# [OPTIONAL] Development and test database overrides for guardrails
DEV_DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/trillionskill_dev"
DEV_DIRECT_URL="postgresql://postgres:postgres_password@localhost:5432/trillionskill_dev"
TEST_DATABASE_URL="postgresql://postgres:testpassword123@127.0.0.1:54329/trillionskill_test"
TEST_DB_NAME="trillionskill_test"

# [OPTIONAL] Enforce connection_limit parameter in DATABASE_URL during startup ("true" | "false")
EXAM_REQUIRE_POOL_LIMIT="false"

# [OPTIONAL] Verbose Prisma query logging ("true" | "false")
PRISMA_LOG_QUERIES="false"


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSIONS (NextAuth / JWT / OAuth)
# ------------------------------------------------------------------------------
# [REQUIRED] Primary symmetric encryption secret for NextAuth sessions (min 32 chars)
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
NEXTAUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# [OPTIONAL] NextAuth canonical URL override
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# [OPTIONAL] Dev-only mobile authentication bypass (strictly ignored in production)
ALLOW_DEV_MOBILE_LOGIN="false"

# [OPTIONAL] Google OAuth Client IDs (supports comma-separated for multi-client apps)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_IDS="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# [OPTIONAL] Google ID token testing secret for test suites
GOOGLE_ID_TOKEN_TEST_SECRET=""

# [OPTIONAL] Enforce verified email before allowing course/book checkout ("true" | "false")
REQUIRE_EMAIL_VERIFICATION_FOR_PURCHASE="false"


# ------------------------------------------------------------------------------
# 4. BRAND & LEGAL ENTITY
# ------------------------------------------------------------------------------
# [OPTIONAL] Brand name display overrides
BRAND_NAME="AspirantBook"
NEXT_PUBLIC_APP_NAME="AspirantBook"

# [OPTIONAL] Registered legal business entity name
LEGAL_ENTITY_NAME="Prince Singh (Sole Proprietor), trading as AspirantBook"

# [OPTIONAL] Official learner support email
SUPPORT_EMAIL="hello@aspirantbook.com"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@aspirantbook.com"

# [OPTIONAL] Official learner helpline phone number
SUPPORT_PHONE="+91 8340665934"
NEXT_PUBLIC_SUPPORT_PHONE="+91 8340665934"

# [OPTIONAL] Support desk operating hours
SUPPORT_HOURS="Mon-Sat, 10:00 AM - 6:00 PM IST"

# [OPTIONAL] Designated Grievance Officer details
GRIEVANCE_OFFICER="Prince Singh"
GRIEVANCE_EMAIL="grievance@aspirantbook.com"

# [OPTIONAL] Physical registered office address
REGISTERED_ADDRESS="Pawar View, RK Puram, Near IIT Delhi, Hauz Khas, New Delhi, Delhi - 110016"

# [OPTIONAL] Official social media links
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/aspirantbook"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/@aspirantbook"
NEXT_PUBLIC_TWITTER_URL="https://twitter.com/aspirantbook"


# ------------------------------------------------------------------------------
# 5. PAYMENTS (Razorpay & Stripe)
# ------------------------------------------------------------------------------
# [REQUIRED for Razorpay] Razorpay API credentials
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# [OPTIONAL] Stripe API credentials
STRIPE_SECRET_KEY="sk_test_YOUR_SECRET_KEY_HERE"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_PUBLISHABLE_KEY_HERE"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# [OPTIONAL] Stripe recurring subscription plan IDs
STRIPE_MONTHLY_PRICE_ID="price_YOUR_MONTHLY_PRICE_ID"
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID="price_YOUR_MONTHLY_PRICE_ID"
STRIPE_YEARLY_PRICE_ID="price_YOUR_YEARLY_PRICE_ID"
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID="price_YOUR_YEARLY_PRICE_ID"


# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (AWS S3 & CloudFront & S3-Compatible)
# ------------------------------------------------------------------------------
# [REQUIRED for file uploads] S3 credentials and bucket name
AWS_ACCESS_KEY_ID="your_access_key_id"
S3_ACCESS_KEY="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
S3_SECRET_KEY="your_secret_access_key"
AWS_S3_BUCKET_NAME="aspirantbook-storage"
AWS_S3_BUCKET="aspirantbook-storage"
S3_BUCKET="aspirantbook-storage"

# [OPTIONAL] AWS region (default: ap-south-1)
AWS_REGION="ap-south-1"
S3_REGION="ap-south-1"

# [OPTIONAL] Custom endpoint for MinIO / local development
AWS_ENDPOINT=""
S3_ENDPOINT=""

# [OPTIONAL] Force path style URLs for MinIO ("true" | "false")
AWS_S3_FORCE_PATH_STYLE="false"
S3_FORCE_PATH_STYLE="false"

# [OPTIONAL] CloudFront CDN domain for media delivery
AWS_CLOUDFRONT_DOMAIN="cdn.aspirantbook.com"

# [OPTIONAL] Local or S3 storage root prefix for book PDFs
BOOK_STORAGE_ROOT="books"

# [OPTIONAL] PDF watermark template text
BOOK_PDF_WATERMARK="AspirantBook Licensed Copy"


# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL & NOTIFICATIONS (Resend / Brevo)
# ------------------------------------------------------------------------------
# [OPTIONAL] Default sender email address
EMAIL_FROM="AspirantBook <hello@aspirantbook.com>"

# [OPTIONAL] Resend API credentials
RESEND_API_KEY="re_your_resend_api_key"
RESEND_API_URL="https://api.resend.com"

# [OPTIONAL] Brevo API credentials
BREVO_API_KEY="your_brevo_api_key"
BREVO_API_URL="https://api.brevo.com/v3"

# [OPTIONAL] Email outbox retry and backoff settings
EMAIL_OUTBOX_MAX_ATTEMPTS="5"
EMAIL_OUTBOX_BACKOFF_BASE_SEC="2"


# ------------------------------------------------------------------------------
# 8. SMS & OTP SERVICES
# ------------------------------------------------------------------------------
# [OPTIONAL] Fast2SMS gateway key
FAST2SMS_API_KEY=""

# [OPTIONAL] MSG91 authentication key
MSG91_AUTH_KEY=""

# [OPTIONAL] Twilio auth token
TWILIO_AUTH_TOKEN=""

# [OPTIONAL] Generic SMS gateway API key
SMS_API_KEY=""

# [OPTIONAL] Message Central (Verify Now) — real mobile OTP login.
# Set BOTH to enable OTP; leave BOTH empty to keep OTP disabled.
# MESSAGE_CENTRAL_AUTH_KEY is the base64-encrypted password from the console.
MESSAGE_CENTRAL_CUSTOMER_ID=""
MESSAGE_CENTRAL_AUTH_KEY=""
# Optional override; defaults to https://cpaas.messagecentral.com
MESSAGE_CENTRAL_BASE_URL=""


# ------------------------------------------------------------------------------
# 9. MOBILE APPLICATION & PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
# [OPTIONAL] Enable native mobile shell layout below 1024px ("true" | "false")
NEXT_PUBLIC_ENABLE_MOBILE_NATIVE_SHELL="true"

# [OPTIONAL] Allow digital in-app purchases on mobile platforms ("true" | "false")
NEXT_PUBLIC_APP_ALLOW_PURCHASE="false"

# [OPTIONAL] Enable Expo mobile push notification delivery ("true" | "false")
ENABLE_MOBILE_PUSH="false"

# [OPTIONAL] Expo push notifications access token
EXPO_ACCESS_TOKEN=""

# [OPTIONAL] Expo push notification HTTP endpoint
EXPO_PUSH_ENDPOINT="https://exp.host/--/api/v2/push/send"

# [OPTIONAL] Mobile app version gating
LATEST_APP_VERSION="1.0.0"
MIN_SUPPORTED_APP_VERSION="1.0.0"


# ------------------------------------------------------------------------------
# 10. BOT PROTECTION & SECURITY (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# [OPTIONAL] Enable Cloudflare Turnstile CAPTCHA on forms ("true" | "false")
TURNSTILE_ENABLED="false"

# [OPTIONAL] Turnstile site key and secret key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# [OPTIONAL] Cloudflare Turnstile server verification URL
TURNSTILE_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"

# [OPTIONAL] Verification timeout in milliseconds
TURNSTILE_TIMEOUT_MS="5000"


# ------------------------------------------------------------------------------
# 11. LIVE STREAMING & RTC (Agora)
# ------------------------------------------------------------------------------
# [OPTIONAL] Agora RTC application ID
NEXT_PUBLIC_AGORA_APP_ID=""

# [OPTIONAL] Agora token certificate and credentials
AGORA_APP_CERTIFICATE=""
AGORA_CUSTOMER_ID=""
AGORA_CUSTOMER_SECRET=""


# ------------------------------------------------------------------------------
# 12. CODE EXECUTION & AI SERVICES
# ------------------------------------------------------------------------------
# [OPTIONAL] Piston remote code execution API URL
PISTON_API_URL="https://emkc.org/api/v2/piston"

# [OPTIONAL] Google Gemini API Key for AI features
GEMINI_API_KEY=""


# ------------------------------------------------------------------------------
# 13. REDIS & RUNTIME PERFORMANCE FLAGS
# ------------------------------------------------------------------------------
# [OPTIONAL] Redis connection string for caching and distributed rate limits
REDIS_URL="redis://localhost:6379"

# [OPTIONAL] Exam rate limiting toggle ("true" | "false")
EXAM_RATE_LIMIT_ENABLED="true"

# [OPTIONAL] Exam runtime high-throughput feature flags
EXAM_RUNTIME_REDIS_RATELIMIT="false"
EXAM_RUNTIME_CACHE_QUESTIONS="false"
EXAM_RUNTIME_CACHE_LEADERBOARD="false"
EXAM_RUNTIME_BATCH_SYNC="false"
EXAM_RUNTIME_FAST_GRADING="false"

# [OPTIONAL] Cache TTL durations in seconds
EXAM_QUESTIONS_CACHE_TTL_SECS="3600"
EXAM_QUESTIONS_VERSION_CHECK_TTL_SECS="60"
EXAM_LEADERBOARD_CACHE_TTL_SECS="30"


# ------------------------------------------------------------------------------
# 14. DEMO DATA & SANDBOX
# ------------------------------------------------------------------------------
# [OPTIONAL] Seed demo courses and mock data ("true" | "false")
ENABLE_DEMO_DATA="false"


# ------------------------------------------------------------------------------
# 15. ERROR MONITORING (Sentry)
# ------------------------------------------------------------------------------
# [OPTIONAL] Sentry DSN for error reporting (absent/empty = no-op, zero network calls)
SENTRY_DSN=""

# [OPTIONAL] Sentry environment tag (defaults to NODE_ENV or 'development')
SENTRY_ENVIRONMENT="production"

# [OPTIONAL] Sentry release tag / git commit SHA
SENTRY_RELEASE=""

