# Authentication
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Stripe (Test Mode)
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_YOUR_SECRET_KEY_HERE"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_PUBLISHABLE_KEY_HERE"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# Stripe Price IDs
# Create products in Stripe Dashboard and copy the price IDs
STRIPE_MONTHLY_PRICE_ID="price_YOUR_MONTHLY_PRICE_ID"
STRIPE_YEARLY_PRICE_ID="price_YOUR_YEARLY_PRICE_ID"
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID="price_YOUR_MONTHLY_PRICE_ID"
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID="price_YOUR_YEARLY_PRICE_ID"

# Razorpay (Test Mode)
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Piston API (Code Execution) - Optional, defaults to public instance
PISTON_API_URL=https://emkc.org/api/v2/piston

# AWS S3 Configuration (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET_NAME=your_bucket_name
AWS_CLOUDFRONT_DOMAIN=your_cloudfront_domain.cloudfront.net # Optional:3000"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
