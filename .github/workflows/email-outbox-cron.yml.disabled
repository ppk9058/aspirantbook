name: Email Outbox Worker (Disabled Stub)

# DISABLED scheduled-workflow stub.
# This file intentionally has a .disabled extension so GitHub Actions does NOT
# load it and there are ZERO active triggers (no schedule, no workflow_dispatch).
# To enable: rename to email-outbox-cron.yml, restore the trigger block below,
# remove the 'if: false' condition, and configure CRON_SECRET and APP_URL secrets.
#
# on:
#   schedule:
#     - cron: '*/5 * * * *' # Every 5 minutes
#   workflow_dispatch:

jobs:
  process-email-outbox:
    runs-on: [self-hosted, macOS, ARM64, mac-ci]
    # if: false # STUB: was explicitly disabled before the file was renamed
    steps:
      - name: Trigger Email Outbox Worker Route
        run: |
          curl -f -s -X POST \
            -H "Authorization: Bearer ${{ secrets.CRON_SECRET }}" \
            -H "Content-Type: application/json" \
            "${{ secrets.APP_URL }}/api/internal/email-outbox"
