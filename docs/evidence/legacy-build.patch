diff --git a/.dockerignore b/.dockerignore
new file mode 100644
index 0000000..70fcdf7
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,33 @@
+# Dependencies & version control
+node_modules
+.git
+.gitignore
+
+# Next.js & Build outputs
+.next
+.next-test
+out
+dist
+build
+
+# Environment files - strictly forbidden to bake into image
+.env
+.env*
+!.env.example
+
+# Loadtest & Performance results
+tools/loadtest/results
+evidence
+reports
+logs
+
+# Mobile app artefacts
+apps/mobile/node_modules
+apps/mobile/.expo
+apps/mobile/android
+apps/mobile/ios
+
+# Coverage & test caches
+coverage
+.nyc_output
+*.tsbuildinfo
diff --git a/Dockerfile b/Dockerfile
index 1ff26ec..225aa87 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,26 +1,35 @@
 # syntax=docker/dockerfile:1
 # -----------------------------------------------------------------------------
-# Production Multi-Stage Dockerfile for TrillionSkill Next.js Standalone
+# Production Multi-Stage Host-Agnostic Dockerfile for TrillionSkill
+# Node: 22 (Debian Bookworm Slim)
 # -----------------------------------------------------------------------------
 
-FROM node:20-alpine AS base
-RUN apk add --no-cache libc6-compat openssl
+FROM node:22-bookworm-slim AS base
+RUN apt-get update && apt-get install -y --no-install-recommends \
+    openssl \
+    ca-certificates \
+    curl \
+  && rm -rf /var/lib/apt/lists/*
 WORKDIR /app
 
-# 1. Install dependencies
+# 1. Install all dependencies (including dev for building)
 FROM base AS deps
 COPY package.json package-lock.json* ./
 COPY prisma ./prisma/
-RUN npm ci --omit=dev --ignore-scripts && npx prisma generate
+RUN npm ci --ignore-scripts && npx prisma generate
 
-# 2. Build the application
+# 2. Build Next.js application
 FROM base AS builder
 WORKDIR /app
 COPY --from=deps /app/node_modules ./node_modules
 COPY . .
-ENV NEXT_STANDALONE=1
+ENV NEXT_STANDALONE=true
 ENV NODE_ENV=production
 ENV NEXT_TELEMETRY_DISABLED=1
+# Dummy build-time variables (never baked into final runner image)
+ENV AUTH_SECRET="build_dummy_auth_secret_placeholder"
+ENV DATABASE_URL="postgresql://placeholder:placeholder@127.0.0.1:54329/placeholder_build_test"
+ENV DIRECT_URL="postgresql://placeholder:placeholder@127.0.0.1:54329/placeholder_build_test"
 RUN npx prisma generate && npm run build
 
 # 3. Production runner
@@ -32,10 +41,10 @@ ENV PORT=3000
 ENV HOSTNAME="0.0.0.0"
 ENV NEXT_TELEMETRY_DISABLED=1
 
-RUN addgroup --system --gid 1001 nodejs
-RUN adduser --system --uid 1001 nextjs
+RUN groupadd --system --gid 1001 nodejs && \
+    useradd --system --uid 1001 -g nodejs nextjs
 
-# Copy standalone build and static assets
+# Copy standalone output and static assets
 COPY --from=builder /app/public ./public
 COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
 COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
@@ -44,7 +53,7 @@ USER nextjs
 
 EXPOSE 3000
 
-HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
-  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1
+HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
+  CMD curl -f http://127.0.0.1:${PORT:-3000}/api/health || exit 1
 
 CMD ["node", "server.js"]
