# API Base URL
# Precedence: Shell Env > .env.local > dev-derived host (when __DEV__=true) > unconfigured error
#
# In development (__DEV__=true):
# If EXPO_PUBLIC_API_URL is omitted, the app dynamically derives the host from the Metro host
# (Constants.expoConfig.hostUri or Constants.linkingUri) using port EXPO_PUBLIC_API_PORT (default: 3045).
# Example derived URL on LAN: http://<mac-ip>:3045
#
# To explicitly pin a backend URL (or in production builds, where derivation is disabled):
EXPO_PUBLIC_API_URL=

# Port for dev-derived host (default 3045)
EXPO_PUBLIC_API_PORT=3045

# Sentry DSN (optional, monitoring disabled until provided)
EXPO_PUBLIC_SENTRY_DSN=
