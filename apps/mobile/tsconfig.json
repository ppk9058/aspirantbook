{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-native",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["../../src/*"],
      "@aspirantbook/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
